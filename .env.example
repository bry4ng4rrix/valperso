# Copier ce fichier en .env puis adapter les valeurs. Ne jamais versionner le fichier .env.

APP_NAME="Gestion Commerciale API"
APP_ENV=development
DEBUG=false

# Base utilisée par l'API lancée sur la machine (hors Docker).
# Avec Docker Compose, l'API utilise automatiquement le service "postgres".
DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5434/commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce
POSTGRES_DB=commerce

# Ports exposés sur la machine par Docker Compose.
POSTGRES_PORT=5434
API_PORT=8000

# Générer un secret : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Origines autorisées à appeler l'API (frontend), séparées par des virgules.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Seuil de stock faible et fuseau horaire des statistiques.
LOW_STOCK_THRESHOLD=5
TIMEZONE=Indian/Antananarivo

# Premier administrateur créé par : python -m app.seed
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-me-admin
FIRST_ADMIN_EMAIL=admin@example.com
