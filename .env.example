# Copier ce fichier en .env puis adapter les valeurs. Ne jamais versionner le fichier .env.

APP_NAME="Gestion Commerciale API"
APP_ENV=development
DEBUG=false

# Base utilisée par l'API lancée sur la machine (hors Docker).
# Avec Docker Compose, l'API utilise automatiquement le service "postgres".
DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5434/commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce
POSTGRES_DB=commerce

# Ports exposés sur la machine par Docker Compose.
POSTGRES_PORT=5434
API_PORT=8000

# Générer un secret : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=jUcl5lfHJHoUJdsXZIp2uUX__tnY83lp8GUQqpLIMrOIDbK9WfhWB_1-qGRJFae3
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Origines autorisées à appeler l'API (frontend), séparées par des virgules.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Premier ADMIN créé par le seed (python -m app.seed). Changez le mot de passe !
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-admin

# Nom de la société créé par le seed (logo, adresse, ville... se configurent avec PUT /api/v1/company).
COMPANY_NAME=Allsafe

# Mot de passe des comptes de démonstration créés par : python -m app.seed_demo (développement uniquement).
DEMO_PASSWORD=

# Seuil d'alerte par défaut des nouvelles lignes de stock, et fuseau horaire des statistiques.
DEFAULT_ALERT_THRESHOLD=5
TIMEZONE=Indian/Antananarivo

# Caisses : ouverture et fermeture automatiques chaque jour (heure du fuseau CASH_SCHEDULE_TIMEZONE).
CASH_AUTO_SCHEDULE=true
CASH_AUTO_OPEN_TIME=06:00
CASH_AUTO_CLOSE_TIME=19:00
CASH_SCHEDULE_TIMEZONE=Indian/Antananarivo
